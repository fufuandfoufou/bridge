#!/usr/bin/env python3
"""Minimal external bridge adapter: one read-only session, JSON-RPC 2.0 on stdio."""
import json, sys

CAPS = {"session_read": True, "session_write": False, "live_tail": False, "mcp": False,
        "context_window": 100000, "tools": [{"canonical": "shell", "native": "run"}]}
REF = {"agent": "demo", "native_id": "demo-1", "path": "demo-1", "cwd": "/tmp/demo",
       "started_at": "2026-11-09T10:00:00Z", "updated_at": "2026-11-09T10:00:00Z"}
EVENTS = [{"seq": 1, "kind": "message", "role": "user", "ts": "2026-11-09T10:00:00Z",
           "content": [{"type": "text", "text": "hello from demo"}]}]

def handle(method, params):
    if method == "initialize":
        return {"protocol_version": "1", "capabilities": CAPS}
    if method == "detect":
        return {"installed": True, "version": "1.0", "data_dir": "/tmp/demo"}
    if method == "sessions/list":
        return {"sessions": [REF]}
    if method == "sessions/read":
        start = params["from"].get("next_seq", 0)
        return {"events": EVENTS[start:], "cursor": {"agent": "demo", "native_file": "demo-1", "offset": 1, "inode": 0, "next_seq": 1}}
    if method in ("hooks/install", "hooks/uninstall"):
        return {}
    raise KeyError(method)

for line in sys.stdin:
    req = json.loads(line)
    try:
        out = {"jsonrpc": "2.0", "id": req["id"], "result": handle(req["method"], req.get("params") or {})}
    except KeyError:
        out = {"jsonrpc": "2.0", "id": req["id"], "error": {"code": -32601, "message": "method not found"}}
    print(json.dumps(out), flush=True)
